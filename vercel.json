{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm --dir src install --frozen-lockfile",
  "buildCommand": "pnpm --dir src --filter @workspace/reskill-ai run build && node scripts/copy-dist.js",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://sdc2026-hackathon-4bit-skilytics.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
