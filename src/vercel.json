{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "artifacts/reskill-ai/dist/public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://sdc2026-hackathon-4bit-skilytics.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
