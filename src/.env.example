# ==============================================================================
# Skilytics Environment Variables Example
# Copy this file to src/.env and configure your variables
# ==============================================================================

# Database Configuration (Neon PostgreSQL)
DATABASE_URL=postgresql://user:pass@host/neondb?sslmode=require&channel_binding=require
DATABASE_URL_UNPOOLED=postgresql://user:pass@host/neondb?sslmode=require&channel_binding=require

# Server Configuration
PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# Authentication & Session Security (Required)
SESSION_SECRET=skilytics_secret_session_key_demo_2026_secure

# ==============================================================================
# AI Provider Options
# ==============================================================================
# AI_PROVIDER: "gemini" | "runpod" | "groq" | "mock"
# Default: If GEMINI_API_KEY is present, Gemini is chosen. Otherwise RunPod.

# Option 1 (Recommended for Free Testing): Google Gemini Free API
# Dapatkan API key percuma dari Google AI Studio: https://aistudio.google.com
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.0-flash

# Option 2: RunPod Serverless GPU (vLLM)
RUNPOD_API_KEY=
RUNPOD_LLM_ENDPOINT_ID=
RUNPOD_LIGHT_ENDPOINT_ID=
RUNPOD_LLM_MODEL=qwen/qwen3.5-27b
RUNPOD_LIGHT_MODEL=qwen/qwen3.5-9b

# Option 3: Groq Free API (https://console.groq.com)
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Option 4: Local Zero-Credit Mock Engine
# Tidak memerlukan sebarang API key, internet, atau kredit RunPod sama sekali.
# Sangat pantas (<5ms) dan membaca CV mengikut format tepat.
# AI_TEST_MODE=true
