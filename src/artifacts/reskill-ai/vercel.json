{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm --filter @workspace/reskill-ai... install --frozen-lockfile",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist/public",
  "cleanUrls": false,
  "routes": [
    { "src": "/api/(.*)", "dest": "https://sdc2026-hackathon-4bit-skilytics.onrender.com/api/$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
