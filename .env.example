# ==============================================================================
# Skilytics Environment Variables Configuration (.env.example)
# AI-Powered Future-Ready Workforce & Career Reskilling Platform
# ==============================================================================

# ==========================================
# Database Configuration (Neon PostgreSQL)
# ==========================================
# Pooled connection string (used by backend queries via Drizzle ORM)
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# Direct unpooled connection string (used for schema migrations and DDL)
DATABASE_URL_UNPOOLED="postgresql://user:pass@host/db?sslmode=require"

# ==========================================
# Server Runtime Configuration
# ==========================================
PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# ==========================================
# Authentication & Session Security
# ==========================================
# High-entropy cryptographic secret for signing and securing session cookies
SESSION_SECRET="your_session_secret_here"

# ==========================================
# AI & LLM Inference Configuration (RunPod)
# ==========================================
# RunPod Serverless GPU API Key
RUNPOD_API_KEY="your_runpod_api_key_here"

# Deep reasoning & pathway synthesis endpoint identifier
RUNPOD_LLM_ENDPOINT_ID="your_runpod_llm_endpoint_id_here"

# Lightweight fast-response endpoint identifier
RUNPOD_LIGHT_ENDPOINT_ID="your_runpod_light_endpoint_id_here"

# Model checkpoint names
RUNPOD_LLM_MODEL="deepseek-ai/DeepSeek-R1-Distill-Qwen-32B"
RUNPOD_LIGHT_MODEL="meta-llama/Llama-3.2-3B-Instruct"

# ==========================================
# Google Generative AI Configuration (Gemini)
# ==========================================
# Google Gemini API Key (@google/genai) for CV parsing and structured extraction
GEMINI_API_KEY="your_gemini_api_key_here"
